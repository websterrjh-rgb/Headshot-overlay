<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Author headshot overlay</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=swap">
<style>
:root{--bg:#f3f7f9;--panel:#fff;--ink:#10252f;--muted:#5a707b;--line:#cfdce2;--accent:#8ed3f0;--accent-ink:#0b3a4f;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1a20;--panel:#15252d;--ink:#e8f3f8;--muted:#93aab5;--line:#2b4450}}
:root[data-theme="dark"]{--bg:#0e1a20;--panel:#15252d;--ink:#e8f3f8;--muted:#93aab5;--line:#2b4450}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.5 Archivo,system-ui,sans-serif}
main{max-width:1100px;margin:0 auto;padding:28px 20px 48px;display:grid;grid-template-columns:340px 1fr;gap:28px;align-items:start}
h1{grid-column:1/-1;margin:0;font-weight:800;font-size:clamp(26px,4vw,38px);letter-spacing:-.02em}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px;display:grid;gap:18px}
.field>span{display:block;font-weight:600;margin-bottom:6px}
.drop{position:relative;display:grid;place-items:center;min-height:130px;border:2px dashed var(--line);border-radius:10px;overflow:hidden;cursor:pointer;text-align:center;color:var(--muted);padding:12px}
.drop:hover,.drop.over,.drop:focus-within{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,transparent)}
.drop input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.drop img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none}
.drop.has img{display:block}
.drop.has .hint{position:relative;background:rgba(0,0,0,.65);color:#fff;border-radius:6px;padding:2px 10px;font-size:14px}
.drop.round{width:150px;height:150px;min-height:0;border-radius:50%}
input[type=text]{width:100%;font:inherit;padding:10px 12px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--ink)}
input[type=text]:focus-visible,.drop:focus-within{outline:2px solid var(--accent);outline-offset:2px}
button{font:600 16px Archivo,system-ui,sans-serif;padding:12px 16px;border:0;border-radius:8px;background:var(--accent);color:var(--accent-ink);cursor:pointer}
button:disabled{opacity:.45;cursor:not-allowed}
button:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.stage{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;min-height:260px;display:grid;place-items:center}
canvas{max-width:100%;height:auto;border-radius:6px;display:none}
.stage.ready canvas{display:block}
.stage.ready .empty{display:none}
.empty{color:var(--muted);text-align:center;max-width:32ch}
.note{font-size:14px;color:var(--muted);margin:0}
#msg{min-height:1.4em}
@media (max-width:820px){main{grid-template-columns:1fr}}
</style>
</head>
<body>
<main>
  <h1>Author headshot overlay</h1>
  <section class="panel" aria-label="Inputs">
    <div class="field"><span id="l1">Main image</span>
      <label class="drop" id="d1"><img alt=""><span class="hint">Drop an image or click to choose</span><input type="file" accept="image/*" aria-labelledby="l1"></label></div>
    <div class="field"><span id="l2">Headshot</span>
      <label class="drop round" id="d2"><img alt=""><span class="hint">Choose headshot</span><input type="file" accept="image/*" aria-labelledby="l2"></label></div>
    <label class="field"><span>Author name</span><input type="text" id="name" placeholder="Dave Smith" autocomplete="off"></label>
    <label class="field"><span>Job title (optional)</span><input type="text" id="title" placeholder="Senior editor" autocomplete="off"></label>
    <button id="dl" disabled>Download PNG</button>
    <p class="note" id="msg" role="status"></p>
  </section>
  <section class="stage" id="stage" aria-label="Preview">
    <p class="empty">Add a main image to see the preview. The headshot appears in the bottom right corner.</p>
    <canvas id="cv"></canvas>
  </section>
</main>
<script>
(function(){
  var COLOR="#8ed3f0", INK="#0b3a4f", DIAM=300, RING=44, MARGIN=48;
  var imgs={main:null,head:null};
  var cv=document.getElementById("cv"), ctx=cv.getContext("2d");
  var nameEl=document.getElementById("name"), dl=document.getElementById("dl"), msg=document.getElementById("msg");

  function wire(id,key){
    var box=document.getElementById(id), input=box.querySelector("input"), prev=box.querySelector("img");
    function load(file){
      if(!file||file.type.indexOf("image/")!==0){msg.textContent="That file isn't an image. Choose a JPG, PNG or WebP.";return;}
      var url=URL.createObjectURL(file), im=new Image();
      im.onload=function(){imgs[key]=im;prev.src=url;box.classList.add("has");msg.textContent="";draw();};
      im.onerror=function(){msg.textContent="That image couldn't be read. Try another file.";};
      im.src=url;
    }
    input.addEventListener("change",function(){load(input.files[0]);});
    ["dragenter","dragover"].forEach(function(e){box.addEventListener(e,function(ev){ev.preventDefault();box.classList.add("over");});});
    ["dragleave","drop"].forEach(function(e){box.addEventListener(e,function(ev){ev.preventDefault();box.classList.remove("over");});});
    box.addEventListener("drop",function(ev){load(ev.dataTransfer.files[0]);});
  }
  wire("d1","main"); wire("d2","head");
  nameEl.addEventListener("input",draw);
  var titleEl=document.getElementById("title");titleEl.addEventListener("input",draw);

  function ringText(cx,cy,rMid,text,bottom,startSize){
    var size=startSize, track=2, chars=Array.from(text.trim());
    function measure(){
      ctx.font="800 "+size+"px Archivo, system-ui, sans-serif";
      var w=chars.map(function(c){return ctx.measureText(c).width+track;});
      return {w:w,total:w.reduce(function(x,y){return x+y;},0)};
    }
    var m=measure(), maxArc=2*Math.PI*rMid*0.45;
    if(m.total>maxArc){size=size*maxArc/m.total;m=measure();}
    ctx.fillStyle=INK;ctx.textAlign="center";ctx.textBaseline="middle";
    var pos=-m.total/2;
    for(var i=0;i<chars.length;i++){
      var a=(pos+m.w[i]/2)/rMid;
      ctx.save();ctx.translate(cx,cy);ctx.rotate(bottom?-a:a);
      ctx.fillText(chars[i],0,bottom?rMid:-rMid);ctx.restore();
      pos+=m.w[i];
    }
  }

  function draw(){
    var stage=document.getElementById("stage");
    if(!imgs.main){stage.classList.remove("ready");dl.disabled=true;return;}
    var W=imgs.main.naturalWidth,H=imgs.main.naturalHeight;
    cv.width=W;cv.height=H;
    ctx.drawImage(imgs.main,0,0,W,H);
    if(imgs.head){
      var outer=DIAM/2, R=outer-RING, cx=W-MARGIN-outer, cy=H-MARGIN-outer;
      ctx.beginPath();ctx.arc(cx,cy,outer,0,Math.PI*2);ctx.fillStyle=COLOR;ctx.fill();
      ctx.save();ctx.beginPath();ctx.arc(cx,cy,R,0,Math.PI*2);ctx.clip();
      var h=imgs.head,s=Math.min(h.naturalWidth,h.naturalHeight),sx=(h.naturalWidth-s)/2,sy=(h.naturalHeight-s)/2;
      ctx.drawImage(h,sx,sy,s,s,cx-R,cy-R,R*2,R*2);ctx.restore();
      if(nameEl.value.trim()){ringText(cx,cy,R+RING/2,nameEl.value,false,26);}
      if(titleEl.value.trim()){ringText(cx,cy,R+RING/2,titleEl.value,true,22);}
    }
    stage.classList.add("ready");dl.disabled=false;
  }

  if(document.fonts&&document.fonts.load){document.fonts.load("800 30px Archivo").then(draw).catch(function(){});}

  dl.addEventListener("click",async function(){
    msg.textContent="";
    var dls=null;
    try{dls=await claude.use("downloads");}catch(e){}
    cv.toBlob(async function(blob){
      if(!blob){msg.textContent="The image couldn't be exported. Try a smaller main image.";return;}
      if(!dls){msg.textContent="Saving isn't available here. Open this page in claude.ai to download.";return;}
      try{await dls.save({filename:"headshot-overlay.png",data:blob});msg.textContent="Saved.";}
      catch(e){msg.textContent=(e&&e.code==="declined")?"Download canceled.":"The file couldn't be saved. Try again.";}
    },"image/png");
  });
})();
</script>
</body>
</html>
